<data name="AccountDS"
      serviceNamespace="http://jamii.savings/ds"
      transports="http https local"
      xmlns="http://ws.wso2.org/dataservice">

    <config id="H2">
        <property name="driverClassName">org.h2.Driver</property>
        <property name="url">jdbc:h2:file:./database/jamiibank;DB_CLOSE_DELAY=-1</property>
        <property name="username">sa</property>
        <property name="password"></property>
    </config>

        <query id="GetAccountDetails" useConfig="H2">
            <param name="accNumber" sqlType="STRING"/>

            <sql>
                SELECT account_number, status, balance, currency
                FROM accounts
                WHERE account_number = ?
            </sql>

            <result element="Accounts" rowName="Account">
                <element name="accountNumber"
                         column="ACCOUNT_NUMBER"
                         xsdType="string"/>
                <element name="status"
                         column="STATUS"
                         xsdType="string"/>
                <element name="balance"
                         column="BALANCE"
                         xsdType="double"/>
                <element name="currency"
                         column="CURRENCY"
                         xsdType="string"/>
            </result>
        </query>

    <resource name="GetAccountDetails">
        <call-query href="GetAccountDetails">
            <with-param name="accNumber" query-param="accNumber"/>
        </call-query>
    </resource>

</data>