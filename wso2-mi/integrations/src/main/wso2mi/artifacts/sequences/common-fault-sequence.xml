<sequence xmlns="http://ws.apache.org/ns/synapse" name="common-fault-sequence">
 <filter source="get-property('PUBLIC_STATUS')" regex="^(400|404|502|503|504)$"><then><property name="HTTP_SC" expression="get-property('PUBLIC_STATUS')" scope="axis2"/></then><else><property name="HTTP_SC" value="502" scope="axis2"/></else></filter>
 <filter source="get-property('PUBLIC_CODE')" regex=".+"><then/><else><property name="PUBLIC_CODE" value="BACKEND_FAILURE"/></else></filter>
 <filter source="get-property('PUBLIC_MESSAGE')" regex=".+"><then/><else><property name="PUBLIC_MESSAGE" value="Upstream service unavailable"/></else></filter>
 <property name="messageType" value="application/json" scope="axis2"/>
 <payloadFactory media-type="json"><format>{"error":{"code":"$1","message":"$2"},"requestId":"$3","timestamp":"$4"}</format><args><arg evaluator="xml" expression="get-property('PUBLIC_CODE')"/><arg evaluator="xml" expression="get-property('PUBLIC_MESSAGE')"/><arg evaluator="xml" expression="get-property('requestId')"/><arg evaluator="xml" expression="get-property('SYSTEM_DATE')"/></args></payloadFactory>
 <respond/>
</sequence>
