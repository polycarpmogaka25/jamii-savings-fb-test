<api xmlns="http://ws.apache.org/ns/synapse" name="AccountsAPI" context="/accounts">
    <resource methods="GET" uri-template="/{accountNumber}">
        <inSequence>
            <property name="accountNumber" expression="get-property('uri.var.accountNumber')"/>
            <!-- Optimized Data Service Call -->
            <dataServiceCall serviceName="AccountDS">
                <source type="inline"/>
                <operations type="single">
                    <operation name="GetAccountDetails">
                        <with-param name="accNumber" expression="get-property('uri.var.accountNumber')"/>
                    </operation>
                </operations>
                <target type="body"/>
            </dataServiceCall>

            <!-- Handle 404 if DB returns empty -->
            <filter xpath="not(//Account)">
                <then>
                    <property name="HTTP_SC" value="404" scope="axis2"/>
                    <payloadFactory media-type="json">
                        <format>{"error": "Account not found"}</format>
                    </payloadFactory>
                    <respond/>
                </then>
            </filter>

            <!-- Envelope Transformation -->
            <property name="SYSTEM_TIME" expression="get-property('SYSTEM_DATE', 'yyyy-MM-dd\'T\'HH:mm:ss.SSSXXX')"/>
            <payloadFactory media-type="json">
                <format>
                    {
                    "accountNumber": "$1",
                    "status": "$2",
                    "balance": {
                    "amount": $3,
                    "currency": "$4"
                    },
                    "requestId": "$5",
                    "timestamp": "$6"
                    }
                </format>
                <args>
                    <arg evaluator="xml" expression="//Account/accountNumber"/>
                    <arg evaluator="xml" expression="//Account/status"/>
                    <arg evaluator="xml" expression="//Account/balance"/>
                    <arg evaluator="xml" expression="//Account/currency"/>
                    <arg evaluator="xml" expression="get-property('MessageID')"/>
                    <arg evaluator="xml" expression="get-property('SYSTEM_TIME')"/>
                </args>
            </payloadFactory>
            <respond/>
        </inSequence>
        <faultSequence>
            <sequence key="common-fault-sequence"/>
        </faultSequence>
    </resource>
    <resource methods="GET" uri-template="/{accountNumber}/balance">
        <inSequence>
            <property name="accountNumber" expression="get-property('uri.var.accountNumber')"/>
            <dataServiceCall serviceName="AccountDS">
                <source type="inline"/>
                <operations type="single">
                    <operation name="GetAccountDetails">
                        <with-param name="accNumber" expression="get-property('uri.var.accountNumber')"/>
                    </operation>
                </operations>
                <target type="body"/>
            </dataServiceCall>

            <filter xpath="not(//Account)">
                <then>
                    <property name="HTTP_SC" value="404" scope="axis2"/>
                    <payloadFactory media-type="json">
                        <format>{"error": "Account not found"}</format>
                    </payloadFactory>
                    <respond/>
                </then>
            </filter>

            <payloadFactory media-type="json">
                <format>
                    {
                    "accountNumber": "$1",
                    "balance": {
                    "amount": $2,
                    "currency": "$3"
                    }
                    }
                </format>
                <args>
                    <arg evaluator="xml" expression="//Account/accountNumber"/>
                    <arg evaluator="xml" expression="//Account/balance"/>
                    <arg evaluator="xml" expression="//Account/currency"/>
                </args>
            </payloadFactory>
            <respond/>
        </inSequence>
        <faultSequence>
            <sequence key="common-fault-sequence"/>
        </faultSequence>
    </resource>
</api>