<api xmlns="http://ws.apache.org/ns/synapse" name="LoansAPI" context="/loans">
    <resource methods="POST" uri-template="/eligibility">
        <inSequence>
            <!-- Check for Malformed Input (400) -->
            <filter xpath="not(//income) or not(//debt)">
                <then>
                    <property name="ERROR_CODE" value="400"/>
                    <property name="ERROR_MESSAGE" value="Malformed input: income and debt are required."/>
                    <sequence key="common-fault-sequence"/>
                </then>
            </filter>

            <!-- Store JSON variables -->
            <property name="reqIncome" expression="json-eval($.income)"/>
            <property name="reqDebt" expression="json-eval($.debt)"/>

            <!-- Transform to SOAP Payload -->
            <payloadFactory media-type="xml">
                <format>
                    <soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:tem="http://tempuri.org/">
                        <soapenv:Header/>
                        <soapenv:Body>
                            <tem:Add>
                                <tem:intA>$1</tem:intA>
                                <tem:intB>$2</tem:intB>
                            </tem:Add>
                        </soapenv:Body>
                    </soapenv:Envelope>
                </format>
                <args>
                    <arg evaluator="xml" expression="get-property('reqIncome')"/>
                    <arg evaluator="xml" expression="get-property('reqDebt')"/>
                </args>
            </payloadFactory>

            <header name="Action" value="http://tempuri.org/Add"/>

            <call>
                <endpoint>
                    <address uri="http://www.dneonline.com/calculator.asmx" format="soap11">
                        <timeout>
                            <duration>5000</duration>
                            <responseAction>fault</responseAction>
                        </timeout>
                        <suspendOnFailure>
                            <initialDuration>1000</initialDuration>
                            <progressionFactor>2.0</progressionFactor>
                        </suspendOnFailure>
                    </address>
                </endpoint>
            </call>

            <!-- Check for SOAP Fault -->
            <filter xpath="$body/soapenv:Fault" xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/">
                <then>
                    <property name="ERROR_CODE" value="500"/>
                    <property name="ERROR_MESSAGE" expression="$body/soapenv:Fault/faultstring/text()"/>
                    <sequence key="common-fault-sequence"/>
                </then>
            </filter>

            <!-- Transform SOAP Response back to JSON -->
            <payloadFactory media-type="json">
                <format>
                    {
                    "eligibilityScore": $1,
                    "status": "PROCESSED"
                    }
                </format>
                <args>
                    <arg evaluator="xml" expression="//tem:AddResult" xmlns:tem="http://tempuri.org/"/>
                </args>
            </payloadFactory>
            <property name="messageType" value="application/json" scope="axis2"/>
            <respond/>
        </inSequence>
        <faultSequence>
            <sequence key="common-fault-sequence"/>
        </faultSequence>
    </resource>
</api>